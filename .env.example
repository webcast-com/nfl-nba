# ESPN integration (all optional — the app works with no configuration).

# Origin used for scoreboards + standings. Default: https://site.api.espn.com
# Set to /espn to always go through the Vite proxy instead of calling ESPN directly.
# VITE_ESPN_SITE_BASE_URL=https://site.api.espn.com

# Origin used for season leaders. Default: https://site.web.api.espn.com
# VITE_ESPN_WEB_BASE_URL=https://site.web.api.espn.com

# Set to 1 to force the bundled demo data and skip every ESPN request.
# VITE_ESPN_DISABLE=0

# Sportsrc integration (optional — football fixtures and livestreams on the
# StreamLive page). Your license key from my.sportsrc.org, sent as the
# X-API-KEY header and as an api_key query parameter fallback (the API
# accepts both).
# VITE_SPORTSRC_API_KEY=

# Origin used for football fixtures and livestreams. Default: https://api.sportsrc.org/v3
# Set to /sportsrc to always go through the Vite proxy instead of calling
# Sportsrc directly.
# VITE_SPORTSRC_BASE_URL=https://api.sportsrc.org/v3

# Set to 1 to skip every Sportsrc request (the panel hides and the page falls
# back to its empty ticker).
# VITE_SPORTSRC_DISABLE=0
